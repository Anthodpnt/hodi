{
  "name": "hodi",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev:web": "vite",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/test/**/*.test.ts\"",
    "sources:list": "node --disable-warning=ExperimentalWarning server/cli/list-sources.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@internationalized/date": "^3.12.4",
    "@mozilla/readability": "^0.6.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/language-fr": "^4.1.2",
    "eld": "^2.1.0",
    "entities": "^9.0.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "i18next": "^26.5.12",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.14",
    "react-aria-components": "^1.22.1",
    "react-i18next": "^17.1.9",
    "simple-icons": "^16.36.0",
    "sonner": "2.0.8",
    "undici": "^8.12.3",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@videojs/react": "10.2.0",
    "@videojs/youtube-video": "10.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "1.66.0",
    "overlayscrollbars": "2.17.0",
    "overlayscrollbars-react": "0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-share": "6.1.0",
    "recharts": "3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
